<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <!-- Muss zum Zielframework passen, das PrepareChanSort in ChanSort eingetragen hat.
         net9.0, weil das SQLite-Paket (SQLitePCLRaw.lib.e_sqlite3 2.1.x) nur Browser-Builds bis .NET 9 enthaelt.
         Sobald es eine net10.0-Variante gibt, kann hier (und bei PrepareChanSort) auf net10.0 gewechselt werden. -->
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Nativer Build, damit SQLite (Samsung, Panasonic, Hisense, TCL, ...) im Browser laeuft. Braucht den Workload "wasm-tools". -->
    <WasmBuildNative>true</WasmBuildNative>

    <!-- Kein Trimming: einige Loader nutzen Reflection bzw. "dynamic". Groessere Downloads, dafuer stabil. -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Nur deutsche Uebersetzungen der Loader-Meldungen mitliefern (kleinerer Download) -->
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>

    <!-- System.IO.Hashing (von ChanSort genutzt) ist eine Vorabversion, offiziell erst ab .NET 10; funktioniert aber -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>

    <ChanSortSource>$(MSBuildThisFileDirectory)..\..\chansort\source\</ChanSortSource>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(ChanSortSource)ChanSort.Api\ChanSort.Api.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.Amdb\ChanSort.Loader.Amdb.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.Android\ChanSort.Loader.Android.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.Chmax\ChanSort.Loader.Chmax.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.CmdbBin\ChanSort.Loader.CmdbBin.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.DBM\ChanSort.Loader.DBM.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.DvbViewer\ChanSort.Loader.DvbViewer.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.Enigma2\ChanSort.Loader.Enigma2.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.Grundig\ChanSort.Loader.Grundig.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.Hisense\ChanSort.Loader.Hisense.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.LG\ChanSort.Loader.LG.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.Loewe\ChanSort.Loader.Loewe.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.M3u\ChanSort.Loader.M3u.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.MediaTek\ChanSort.Loader.MediaTek.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.Medion\ChanSort.Loader.Medion.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.Panasonic\ChanSort.Loader.Panasonic.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.Philips\ChanSort.Loader.Philips.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.Samsung\ChanSort.Loader.Samsung.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.SatcoDX\ChanSort.Loader.SatcoDX.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.SdxJson\ChanSort.Loader.SdxJson.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.Sharp\ChanSort.Loader.Sharp.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.Sony\ChanSort.Loader.Sony.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.TCL\ChanSort.Loader.TCL.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.Toshiba\ChanSort.Loader.Toshiba.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.Unsupported\ChanSort.Loader.Unsupported.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.VDR\ChanSort.Loader.VDR.csproj" />
    <ProjectReference Include="$(ChanSortSource)ChanSort.Loader.VisionEdge4K\ChanSort.Loader.VisionEdge4K.csproj" />
    <!-- Nicht enthalten: TechniSat und RefList (alte Projektformate), LG.UI (Windows-Oberflaeche) -->
  </ItemGroup>

  <ItemGroup>
    <!-- Rein verwaltete Zip/Deflate-Implementierung; die native von .NET stuerzt im Browser-Build ab -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Konfigurationsdateien der Loader werden eingebettet und beim Start ins virtuelle Dateisystem geschrieben -->
    <EmbeddedResource Include="$(ChanSortSource)ChanSort.Loader.*\*.ini" LogicalName="ini/%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(ChanSortSource)ChanSort.Api\Lookup.csv" LogicalName="ini/Lookup.csv" />
  </ItemGroup>

</Project>
